---
import { SEO, type Props as SEOProps } from "astro-seo";
const defaultImageFile = new URL("/images/social.jpg", Astro.url);

interface Props {
  seo?: SEOProps;
}

const { seo } = Astro.props;

const siteName = "Nighthawk";
const siteDescription =
  "Nighthawk is a fast-paced aerial survival game where you pilot an F-117 Nighthawk stealth fighter, dodging incoming missiles while they rain down from above.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<SEO
  title={seo?.title}
  description={seo?.description ?? siteDescription}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      url: canonicalURL,
      title: seo?.title ?? siteName,
      type: "website",
      image: defaultImageFile.toString(),
    },
    image: {
      url: defaultImageFile.toString(),
      secureUrl: defaultImageFile.toString(),
      alt: "Nighthawk: a line drawing of the F-117A stealth jet beside the game title on a dark dusk background.",
      type: "image/jpeg",
      width: 1200,
      height: 630,
    },
  }}
  twitter={{
    card: "summary_large_image",
    title: seo?.title ?? siteName,
    description: seo?.description ?? siteDescription,
    image: defaultImageFile.toString(),
    imageAlt:
      "Nighthawk: a line drawing of the F-117A stealth jet beside the game title on a dark dusk background.",
  }}
  extend={{
    meta: [
      {
        name: "og:locale",
        content: "en_US",
      },
      {
        name: "og:description",
        content: seo?.description ?? siteDescription,
      },
      {
        name: "og:site_name",
        content: siteName,
      },
    ],
  }}
/>
