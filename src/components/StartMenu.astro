---
// StartMenu component - Displays the initial overlay before game starts.
// Styled as a dusk mission briefing so it shares the game's sky palette.

// F-117A planform, drawn top-down in a 400 x 620 space (nose up).
// Right half is defined once and mirrored for the left.
const mirror = (points: number[][]) => points.map(([x, y]) => [400 - x, y]);
const toPoints = (points: number[][]) => points.map((p) => p.join(",")).join(" ");

const rightHalf = [
  [200, 24], // nose
  [384, 436], // wingtip leading edge
  [378, 452], // wingtip trailing edge
  [268, 404], // wing root trailing edge
  [262, 470], // aft fuselage
  [238, 556], // tail point
  [200, 512], // centre notch
];
const outline = toPoints([...rightHalf, ...mirror(rightHalf.slice(1, -1)).reverse()]);

const ruddervator = [
  [252, 446],
  [322, 530],
  [316, 540],
  [258, 488],
];
const canopy = toPoints([
  [200, 128],
  [213, 170],
  [211, 206],
  [200, 216],
  [189, 206],
  [187, 170],
]);
const intake = [
  [224, 236],
  [246, 266],
  [242, 296],
  [220, 266],
];

// Facet ridges across the upper skin
const facets = [
  [200, 24, 187, 170],
  [200, 24, 213, 170],
  [200, 216, 200, 512],
  [211, 206, 268, 404],
  [189, 206, 132, 404],
  [246, 300, 378, 452],
  [154, 300, 22, 452],
  [212, 486, 252, 474],
  [188, 486, 148, 474],
];

const specs = [
  { label: "Crew", value: "01" },
  { label: "Top speed", value: "M 0.92" },
  { label: "First flight", value: "1981" },
];
---

<div
  id="start-menu"
  class="fixed inset-0 z-50 overflow-y-auto bg-dusk/85 text-bone font-display backdrop-blur-[3px] transition-opacity duration-500"
  data-game-state="initial"
>
  {/* Atmosphere: warm horizon glow + drafting-paper dot grid + vignette */}
  <div class="pointer-events-none fixed inset-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[radial-gradient(120%_60%_at_70%_110%,rgba(240,163,94,0.18),transparent_60%)]"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(var(--color-bone)_1px,transparent_1px)] bg-size-[24px_24px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(8,5,10,0.85)_100%)]"
    >
    </div>
  </div>

  <div
    class="relative mx-auto flex min-h-full max-w-7xl flex-col px-5 py-5 sm:px-8 sm:py-6"
  >
    {/* Header strip */}
    <header
      class="animate-fade-up flex items-center justify-between gap-4 border-b border-bone/15 pb-3 font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-bone/60"
    >
      <span>Skunk Works <span class="text-amber">//</span> Senior Trend</span>
      <span class="hidden sm:inline">File 117-A · Eyes only</span>
    </header>

    <div
      class="relative grid flex-1 items-center gap-6 py-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-12"
    >
      {/* Briefing copy */}
      <div class="@container relative z-10 flex flex-col gap-7 lg:gap-8">
        <p
          data-menu-status
          class="animate-fade-up flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-amber [animation-delay:100ms]"
        >
          <span class="relative flex size-2">
            <span
              class="absolute inset-0 animate-ping rounded-full bg-amber/70 motion-reduce:hidden"
            ></span>
            <span class="relative size-2 rounded-full bg-amber"></span>
          </span>
          <span data-menu-status-text>Mission briefing · Night sortie</span>
        </p>

        <h1 class="animate-fade-up flex flex-col [animation-delay:200ms]">
          <span
            class="font-mono text-base font-medium tracking-[0.3em] text-bone/70 sm:text-lg"
          >
            Lockheed F-117A
          </span>
          <span
            class="-ml-[0.04em] mt-1 font-black uppercase font-stretch-expanded whitespace-nowrap leading-[0.9] tracking-tight text-[clamp(2.25rem,12cqi,9rem)] text-transparent bg-clip-text bg-linear-to-b from-bone via-bone to-[#b9b2c4]"
          >
            Nighthawk
          </span>
        </h1>

        <p
          class="animate-fade-up max-w-md text-pretty text-base leading-relaxed text-bone/75 font-stretch-semi-condensed sm:text-lg [animation-delay:300ms]"
        >
          Slip through hostile airspace at dusk. Surface-to-air missiles are
          inbound — bank hard, stay low and stay unseen for as long as you
          can.
        </p>

        <dl
          class="animate-fade-up grid max-w-md grid-cols-3 border-y border-bone/15 font-mono [animation-delay:400ms]"
        >
          {
            specs.map(({ label, value }, i) => (
              <div
                class:list={[
                  "flex flex-col gap-1 py-3",
                  i > 0 && "border-l border-bone/15 pl-4",
                ]}
              >
                <dt class="text-[0.625rem] uppercase tracking-[0.2em] text-bone/50">
                  {label}
                </dt>
                <dd class="text-sm text-bone sm:text-base">{value}</dd>
              </div>
            ))
          }
        </dl>

        <div
          class="animate-fade-up flex flex-col gap-5 [animation-delay:500ms]"
        >
          <button
            id="start-button"
            class="group relative flex w-full max-w-md cursor-pointer items-center gap-4 bg-bone px-6 py-4 text-left text-dusk transition-colors duration-200 hover:bg-amber focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber"
            style="clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));"
          >
            <span
              data-start-label
              class="text-lg font-extrabold uppercase tracking-[0.12em] font-stretch-expanded"
              >Start Mission</span
            >
            <span
              class="ml-auto hidden font-mono text-[0.6875rem] uppercase tracking-[0.15em] text-dusk/55 pointer-fine:inline"
              >Enter ↵</span
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              class="size-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1 pointer-coarse:ml-auto"
              aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </button>

          <div
            class="flex items-center gap-3 font-mono text-[0.6875rem] uppercase tracking-[0.15em] text-bone/60"
          >
            <span class="flex gap-1.5 pointer-coarse:hidden" aria-hidden="true">
              <kbd
                class="flex size-7 items-center justify-center border border-bone/30 border-b-2 text-xs text-bone"
                >A</kbd
              >
              <kbd
                class="flex size-7 items-center justify-center border border-bone/30 border-b-2 text-xs text-bone"
                >D</kbd
              >
            </span>
            <p class="pointer-coarse:hidden">Bank left / right</p>
            <p class="hidden pointer-coarse:block">
              Hold the left or right side of the screen to bank.
            </p>
          </div>
        </div>
      </div>

      {/* Planform drawing — sits behind the copy on small screens */}
      <figure
        class="pointer-events-none absolute inset-x-0 top-1/2 z-0 mx-auto w-full max-w-lg -translate-y-1/2 opacity-15 lg:pointer-events-auto lg:relative lg:top-auto lg:max-w-none lg:translate-y-0 lg:opacity-100"
        aria-hidden="true"
      >
        <div class="relative mx-auto aspect-[540/640] max-h-[78vh] overflow-hidden">
          <svg
            viewBox="-70 0 540 640"
            class="absolute inset-0 size-full"
            fill="none"
            stroke-linejoin="round"
          >
            <defs>
              <linearGradient id="planform-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2a2131" stop-opacity="0.9"></stop>
                <stop offset="1" stop-color="#0b080e" stop-opacity="0.9"></stop>
              </linearGradient>
              <clipPath id="airframe-clip">
                <polygon points={outline}></polygon>
              </clipPath>
              <linearGradient id="sweep-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f0a35e" stop-opacity="0"></stop>
                <stop offset="0.85" stop-color="#f0a35e" stop-opacity="0.18"></stop>
                <stop offset="1" stop-color="#f0a35e" stop-opacity="0.5"></stop>
              </linearGradient>
              <pattern
                id="intake-grid"
                width="4"
                height="4"
                patternUnits="userSpaceOnUse"
                patternTransform="rotate(36)"
              >
                <line x1="0" y1="0" x2="0" y2="4" stroke="#ece4d6" stroke-opacity="0.45" stroke-width="1"></line>
              </pattern>
            </defs>

            {/* Airframe */}
            <g stroke="#ece4d6" stroke-width="1.25">
              <polygon points={outline} fill="url(#planform-fill)" pathLength="1" class="planform-draw"></polygon>
              <polygon points={toPoints(ruddervator)} fill="#1a141f" pathLength="1" class="planform-draw [animation-delay:300ms]"></polygon>
              <polygon points={toPoints(mirror(ruddervator))} fill="#1a141f" pathLength="1" class="planform-draw [animation-delay:300ms]"></polygon>
            </g>
            <g stroke="#ece4d6" stroke-opacity="0.35" stroke-width="0.75">
              {
                facets.map(([x1, y1, x2, y2], i) => (
                  <line
                    x1={x1}
                    y1={y1}
                    x2={x2}
                    y2={y2}
                    pathLength="1"
                    class="planform-draw"
                    style={`animation-delay:${500 + i * 60}ms`}
                  />
                ))
              }
            </g>
            <polygon points={canopy} fill="#3a3046" fill-opacity="0.6" stroke="#ece4d6" stroke-opacity="0.7" stroke-width="1" pathLength="1" class="planform-draw [animation-delay:700ms]"></polygon>
            <polygon points={toPoints(intake)} fill="url(#intake-grid)" stroke="#ece4d6" stroke-opacity="0.5" stroke-width="0.75"></polygon>
            <polygon points={toPoints(mirror(intake))} fill="url(#intake-grid)" stroke="#ece4d6" stroke-opacity="0.5" stroke-width="0.75"></polygon>

            {/* Slow scan sweep, clipped to the airframe */}
            <g clip-path="url(#airframe-clip)">
              <rect
                x="0"
                y="-140"
                width="400"
                height="140"
                fill="url(#sweep-fill)"
                class="animate-sweep opacity-0"
              ></rect>
            </g>

            {/* Dimensions + callouts */}
            <g
              stroke="#f0a35e"
              stroke-width="0.75"
              class="animate-fade-up [animation-delay:1200ms]"
            >
              {/* Span */}
              <path d="M16 584 V596 M384 584 V596 M16 590 H168 M232 590 H384"></path>
              {/* Length */}
              <path d="M-36 24 H-24 M-36 556 H-24 M-30 24 V262 M-30 318 V556"></path>
              {/* Leaders */}
              <path d="M279 200 L330 156 H352" stroke-opacity="0.8"></path>
              <path d="M187 176 L120 126 H96" stroke-opacity="0.8"></path>
              <path d="M300 516 L356 496 H372" stroke-opacity="0.8"></path>
              <circle cx="279" cy="200" r="2" fill="#f0a35e"></circle>
              <circle cx="187" cy="176" r="2" fill="#f0a35e"></circle>
              <circle cx="300" cy="516" r="2" fill="#f0a35e"></circle>
            </g>
            <g
              fill="#f0a35e"
              font-family="JetBrains Mono, ui-monospace, monospace"
              font-size="10"
              letter-spacing="1.5"
              class="animate-fade-up [animation-delay:1300ms]"
            >
              <text x="200" y="594" text-anchor="middle">13.20 M</text>
              <text x="-26" y="290" text-anchor="middle" transform="rotate(-90 -30 290)">20.09 M</text>
              <text x="356" y="159">FACETED SKIN</text>
              <text x="92" y="129" text-anchor="end">COCKPIT</text>
              <text x="376" y="499">V-TAIL</text>
            </g>
            <g
              fill="#ece4d6"
              fill-opacity="0.45"
              font-family="JetBrains Mono, ui-monospace, monospace"
              font-size="9"
              letter-spacing="1.5"
              class="animate-fade-up [animation-delay:1400ms]"
            >
              <text x="-62" y="630">FIG. 01 — PLANFORM, TOP</text>
              <text x="462" y="630" text-anchor="end">SCALE 1:52</text>
            </g>
          </svg>

        </div>
      </figure>
    </div>

    {/* Footer strip */}
    <footer
      class="animate-fade-up flex items-center justify-between gap-4 border-t border-bone/15 pt-3 font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-bone/50 [animation-delay:600ms]"
    >
      <span>Tonopah Test Range</span>
      <span class="hidden sm:inline">37°47′N 116°47′W</span>
      <span>Alt 300 ft</span>
    </footer>
  </div>

  <script>
    const startMenu = document.getElementById("start-menu");
    const startButton = document.getElementById("start-button");

    if (startMenu && startButton) {
      // Notify the game that we're in "waiting to start" state
      if (!window.gameAPI) {
        window.gameAPI = {};
      }
      window.gameAPI.gameStarted = false;
      window.gameAPI.playerCanMove = false;
      window.gameAPI.missilesActive = false;

      let isProcessingStart = false;

      const handleStart = () => {
        // Prevent multiple invocations
        if (isProcessingStart) {
          return;
        }
        isProcessingStart = true;

        const isRestart = startMenu.dataset.gameState === "gameover";

        // Reset game state if restarting
        if (isRestart && window.gameAPI?.restart) {
          window.gameAPI.restart();
        }

        // Allow player to move immediately
        if (window.gameAPI) {
          window.gameAPI.playerCanMove = true;
        }

        // Fade out the menu
        startMenu.style.opacity = "0";
        startMenu.style.pointerEvents = "none";

        // Mark that we're in playing state
        startMenu.dataset.gameState = "playing";

        // Delay before missiles start (2 seconds after menu fades)
        setTimeout(() => {
          // Activate missiles and set game as fully started
          if (window.gameAPI) {
            window.gameAPI.missilesActive = true;
            window.gameAPI.gameStarted = true;
          }

          // Dispatch custom event so other components can react
          window.dispatchEvent(new CustomEvent("gamestart"));

          // Reset processing flag
          isProcessingStart = false;
        }, 2500); // 500ms fade + 2000ms delay
      };

      const handleKeyDown = (event: KeyboardEvent) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          handleStart();
        }
      };

      const handleGameOver = () => {
        // Stop the game
        if (window.gameAPI) {
          window.gameAPI.gameStarted = false;
          window.gameAPI.playerCanMove = false;
          window.gameAPI.missilesActive = false;
        }

        // Update menu state and button text
        startMenu.dataset.gameState = "gameover";
        const textSpan = startButton.querySelector("[data-start-label]");
        if (textSpan) {
          textSpan.textContent = "Restart Mission";
        }
        const statusText = startMenu.querySelector("[data-menu-status-text]");
        if (statusText) {
          statusText.textContent = "Aircraft lost · Mission failed";
        }

        // Show the menu again
        startMenu.style.opacity = "1";
        startMenu.style.pointerEvents = "auto";

        // Re-focus the button
        startButton.focus();
      };

      // Start on button click
      startButton.addEventListener("click", handleStart);

      // Also support pressing Enter or Space when button is focused
      startButton.addEventListener("keydown", handleKeyDown);

      // Listen for game over event
      window.addEventListener("gameover", handleGameOver);

      // Auto-focus the button for keyboard accessibility
      startButton.focus();

      // Cleanup function to remove event listeners
      const cleanup = () => {
        startButton.removeEventListener("click", handleStart);
        startButton.removeEventListener("keydown", handleKeyDown);
        window.removeEventListener("gameover", handleGameOver);
        // Clean up global API
        if (window.gameAPI?.showStartMenu) {
          delete window.gameAPI.showStartMenu;
        }
        if (window.gameAPI?.restart) {
          delete window.gameAPI.restart;
        }
      };

      // Cleanup on page navigation (Astro view transitions)
      document.addEventListener("astro:before-preparation", cleanup);
      document.addEventListener("astro:page-load", cleanup);

      // Global restart function to reset all game components
      const restartGame = () => {
        // Reset nighthawk position
        if (window.gameAPI?.nighthawk?.reset) {
          window.gameAPI.nighthawk.reset();
        }

        // Reset missiles
        if (window.gameAPI?.missiles?.restartGame) {
          window.gameAPI.missiles.restartGame();
        }
      };

      // Expose functions for external use
      window.gameAPI.showStartMenu = handleGameOver;
      window.gameAPI.restart = restartGame;
    }
  </script>
</div>
